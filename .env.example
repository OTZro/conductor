# Conductor configuration. Copy to .env and adjust. All vars are prefixed CONDUCTOR_.
# Unknown CONDUCTOR_* keys are flagged in the log at startup (typo guard).

# --- server ---
CONDUCTOR_HOST=127.0.0.1
CONDUCTOR_PORT=8787

# --- database (matches docker-compose) ---
CONDUCTOR_DATABASE_URL=postgresql+asyncpg://conductor:conductor@127.0.0.1:5433/conductor

# --- Jira via acli ---
CONDUCTOR_ACLI_BIN=acli
CONDUCTOR_JIRA_BASE_URL=https://your-org.atlassian.net
# JQL feeding the board. Default (leave unset): tickets assigned to whoever your acli
# is logged in as, in the active statuses (Committed/Building/Hardening) — plus parked
# (hold-labeled) ones, which are your Need Human lane — plus anything resolved in the
# last 10d for the Done lane. To scope it to a team board, prefix its saved filter id, e.g.
#   CONDUCTOR_JIRA_JQL=filter = 13510 AND assignee = currentUser() ORDER BY updated DESC
# Manually-pinned tickets are fetched separately (see the pin UI).
#CONDUCTOR_JIRA_JQL=
CONDUCTOR_JIRA_HOLD_LABEL=conductor-hold

# --- GitHub via gh ---
CONDUCTOR_GH_BIN=gh
CONDUCTOR_GITHUB_QUERY=is:open user-review-requested:@me
# Org scoping the ticket→PR search (cuts global gh-search junk). Change for your org.
CONDUCTOR_GITHUB_ORG=your-org
# Your GitHub login — drives the PR card's "my review" status. Blank = auto-detect via
# `gh api user`; set it only to override.
#CONDUCTOR_GITHUB_LOGIN=

# --- Slack (M4, optional — leave token blank to disable) ---
# User token (xoxp-…) with scopes: im:read, im:history, search:read, users:read
CONDUCTOR_SLACK_TOKEN=
# Your Slack user id. Leave blank — it's auto-derived from the token via auth.test.
CONDUCTOR_SLACK_USER_ID=
# What becomes a job — all optional, sensible defaults:
#CONDUCTOR_SLACK_MAX_AGE_DAYS=7          # ignore mentions/DMs older than this
#CONDUCTOR_SLACK_MENTION_KEEP_DAYS=14    # prune un-actioned @-mentions past this (0 = never)
#CONDUCTOR_SLACK_DMS=true                # false = @-mentions only, no direct messages
#CONDUCTOR_SLACK_EXCLUDE_CHANNELS=       # channels to skip entirely (even a direct @you)
#CONDUCTOR_SLACK_BROADCASTS=false        # true = @channel/@here/@everyone also count
# @usergroups you're in whose pings are noise (skip even as a member):
#CONDUCTOR_SLACK_EXCLUDE_USERGROUPS=release-management
# channels where ONLY a direct @you counts (prefix match; a full name works):
#CONDUCTOR_SLACK_DIRECT_ONLY_PREFIXES=feed-,release_mgmt
# channels where @channel/@here noise is dropped but a direct @you / @group still counts:
#CONDUCTOR_SLACK_BROADCAST_EXCLUDE_CHANNELS=team-mazu
# allowlist: ONLY these @usergroups of yours count (empty = every group you're in):
#CONDUCTOR_SLACK_INCLUDE_USERGROUPS=rd-team,value-expansion
# true = an app/bot post carrying a @group or @channel ping also becomes a job
# (a bot that @-mentions you directly always does, either way):
#CONDUCTOR_SLACK_ALLOW_BOT_MENTIONS=false
# escape hatch — the search query for "someone pinged me", {id} = user/usergroup id.
# Only change this if Slack changes its search behaviour again; every hit is verified
# against whatever this renders, so a wrong value yields fewer cards, never a flood:
#CONDUCTOR_SLACK_MENTION_QUERY_TEMPLATE=<@{id}>

# --- custom personal boards (optional, per-user) ---
# JSON file of extra board tabs: [{"id","label","icon"}]. Lives outside the repo,
# so each user has their own. Notes created on a tab are tagged to it and kept off
# the work board. Default path below; no file = standard board only.
#CONDUCTOR_DASHBOARDS_FILE=~/.conductor/dashboards.json

# --- Claude prompts (optional, per-user) ---
# JSON file overriding the prompts Conductor sends to claude (Slack/PR briefs, session
# seeds, handover) — keep your own language/phrasing per machine; missing keys fall back
# to the shipped English defaults. Keys + placeholders: backend/conductor/prompts.py.
# No file = English defaults. Edits apply without a restart. A Traditional-Chinese set
# ships in the repo: cp config/prompts.zh-TW.example.json ~/.conductor/prompts.json
#CONDUCTOR_PROMPTS_FILE=~/.conductor/prompts.json

# --- notifications (optional) ---
# ntfy.sh topic for cross-device Need-Human pings (macOS Notification Center is automatic)
CONDUCTOR_NTFY_TOPIC=

# --- terminals (M3) ---
CONDUCTOR_TTYD_PORT_START=7500
# Where a card's `claude` runs when it has no explicit dir. Point it at your own code
# root. A missing dir falls back to $HOME.
CONDUCTOR_DEFAULT_WORKSPACE_ROOT=~/code
# Tool binaries — override only if they aren't on the launchd agent's PATH
# (/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:~/.local/bin). Default = resolve on PATH.
#CONDUCTOR_CLAUDE_BIN=claude
#CONDUCTOR_TMUX_BIN=tmux
#CONDUCTOR_TTYD_BIN=ttyd

# --- remote hosts (optional — run a card's claude on another machine over ssh) ---
# Comma-separated "name=ssh-target". The target must accept non-interactive ssh
# (tailscale ssh / keys). Empty = feature off, everything runs locally.
#CONDUCTOR_REMOTE_HOSTS=roam=your-laptop.tailnet.ts.net
# Display name of THIS machine in the host picker.
#CONDUCTOR_LOCAL_HOST_NAME=base
# Conductor's origin AS REACHABLE FROM the remote (the tailscale-serve HTTPS URL);
# remote claude hooks post agent state here. Blank = remote sessions run hook-less
# (the tmux pane poll still tracks lane state, just slower).
#CONDUCTOR_PUBLIC_URL=https://this-machine.tailnet.ts.net
# Default working dir for sessions on the remote (a path on ITS filesystem).
#CONDUCTOR_REMOTE_WORKSPACE_ROOT=~/code

# --- polling cadence ---
CONDUCTOR_POLL_INTERVAL_S=30
CONDUCTOR_TAIL_INTERVAL_S=2.0

# --- authentication (optional — Google + WebAuthn passkeys; see README "Authentication") ---
# Master switch. Keep false until you have registered a passkey and verified you
# can sign in (the auth endpoints work while enforcement is off, on purpose).
#CONDUCTOR_AUTH_ENABLED=false
# Comma-separated allowlist of emails permitted to sign in (case-insensitive).
#CONDUCTOR_ALLOWED_EMAILS=you@example.com
# Google OAuth "Web application" client id; empty hides the Google button.
#CONDUCTOR_GOOGLE_CLIENT_ID=
# One-time bootstrap secret for registering the FIRST passkey without a session
# (login screen → "First-time setup"). Generate:
#   python3 -c "import secrets;print(secrets.token_urlsafe(24))"
# Empty disables the bootstrap flow.
#CONDUCTOR_AUTH_SETUP_TOKEN=
# Session cookie lifetime (sessions are stored in Postgres).
#CONDUCTOR_SESSION_TTL_DAYS=30
# Comma-separated exact origins allowed for login ceremonies. Empty derives:
# http://localhost:{port}, http://127.0.0.1:{port}, the Vite dev origins, and
# CONDUCTOR_PUBLIC_URL when set.
#CONDUCTOR_ALLOWED_ORIGINS=
# Shared bearer token for machine-push endpoints (e.g. the SendUserFile hook, and any
# push-ingest endpoint a source plugin adds — see docs/plugins.md). Empty keeps them
# open; if set, add an Authorization header to the caller.
#CONDUCTOR_INGEST_TOKEN=
